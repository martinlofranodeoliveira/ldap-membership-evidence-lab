<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)build</ArtifactsPath>
    <NativeOwnerOutput>$(MSBuildThisFileDirectory)build/native/$(Configuration)/ldap-evidence-owner</NativeOwnerOutput>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.1.0</Version>
    <Authors>Lofrano Tecnologia</Authors>
    <RepositoryUrl>https://github.com/martinlofranodeoliveira/ldap-membership-evidence-lab</RepositoryUrl>
    <PackageProjectUrl>https://lofranotecnologia.com.br</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute"><_Parameter1>linux</_Parameter1></AssemblyAttribute>
  </ItemGroup>
</Project>
